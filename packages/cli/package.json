{
  "name": "@r-delfino/mux-sync-supabase",
  "version": "0.0.7",
  "description": "CLI tool to initialize Mux Sync Engine with Supabase",
  "keywords": [
    "mux",
    "supabase",
    "cli",
    "webhook",
    "sync",
    "postgres"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mux-sync": "./dist/index.cjs",
    "mux-sync-supabase": "./dist/index.cjs"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "author": "Renzo Delfino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-delfino95/mux-sync-engine.git"
  },
  "bugs": {
    "url": "https://github.com/r-delfino95/mux-sync-engine/issues"
  },
  "homepage": "https://github.com/r-delfino95/mux-sync-engine#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/index.cjs"
  ],
  "dependencies": {
    "@r-delfino/mux-sync-engine": "^0.0.12",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
