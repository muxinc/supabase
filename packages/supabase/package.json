{
  "name": "@mux/supabase",
  "version": "0.0.20",
  "description": "CLI tool to initialize Mux Sync Engine with Supabase",
  "keywords": [
    "mux",
    "supabase",
    "cli",
    "webhook",
    "sync",
    "postgres"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "deno": "./dist/deno.js",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deno": "./dist/deno.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mux-supabase": "dist/index.cjs"
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "prepublishOnly": "npm run build"
  },
  "author": "@muxinc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muxinc/supabase.git"
  },
  "bugs": {
    "url": "https://github.com/muxinc/supabase/issues"
  },
  "homepage": "https://github.com/muxinc/supabase#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/index.cjs",
    "dist/index.js",
    "dist/deno.js",
    "dist/migrations"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@mux/mux-node": "^12.7.0",
    "@mux/sync-engine": "^0.0.4",
    "@supabase/supabase-js": "^2.57.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "inquirer": "^12.9.4",
    "ora": "^8.0.1",
    "pg": "^8.16.3",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/pg": "^8.15.2",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
