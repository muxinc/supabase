{
  "name": "supabase-mux",
  "version": "1.0.0",
  "description": "Supabase integration for Mux video platform",
  "main": "sync-mux.ts",
  "scripts": {
    "sync-mux": "npx ts-node lib/sync-mux.ts",
    "dev": "supabase start",
    "dev:debug": "supabase start --debug",
    "stop": "supabase stop",
    "reset": "supabase db reset",
    "migrate": "supabase db push",
    "functions:serve": "supabase functions serve --env-file .env",
    "functions:deploy": "supabase functions deploy",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "supabase",
    "mux",
    "video",
    "streaming",
    "webhooks"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mux/ts": "^15.5.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supabase": "^2.30.4",
    "ts-node": "^10.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
